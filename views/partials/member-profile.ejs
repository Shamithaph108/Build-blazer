<div class="profile-detail"><% if(member.image) { %><div class="matrix-profile-photo"><canvas class="member-matrix" aria-hidden="true"></canvas><img src="<%= member.image %><%= member.image.includes('?')?'&':'?' %>v=matrix-cutout-2" alt="<%= member.name %>" width="480" height="560"></div><% } %><div><p class="eyebrow"><%= member.role %></p><h2 id="dialog-title"><%= member.name %></h2><% if(member.department) { %><p class="small accent"><%= member.department %></p><% } %><p class="preserve-lines"><%= member.bio %></p><div class="profile-socials"><% for(const [key,label] of [['github','GitHub'],['linkedin','LinkedIn'],['website','Website']]) { if(member[key]) { %><a href="<%= member[key] %>" target="_blank" rel="noopener noreferrer"><%= label %> ↗</a><% } } %></div></div></div>
