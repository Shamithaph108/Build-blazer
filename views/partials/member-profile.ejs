<div class="profile-detail">
  <div class="member-stage">
    <figure class="member-portrait">
      <canvas class="member-matrix" aria-hidden="true"></canvas>
      <% if(member.image) { %><img src="<%= member.image %><%= member.image.includes('?')?'&':'?' %>v=matrix-cutout-2" alt="<%= member.name %>" width="480" height="560"><% } else { %><span class="initials"><%= member.name.split(' ').map(part=>part[0]).slice(0,2).join('') %></span><% } %>
      <span class="member-portrait-mark" aria-hidden="true">C/</span>
    </figure>
    <div class="member-copy">
      <p class="eyebrow"><%= member.role %></p>
      <h2 id="dialog-title"><%= member.name %></h2>
      <% if(member.department) { %><p class="small accent"><%= member.department %></p><% } %>
      <div class="member-bio"><p data-profile-bio><%= member.bio %></p></div>
      <div class="bio-pagination" hidden><button type="button" data-bio-step="-1" aria-label="Previous biography page">←</button><span role="status" data-bio-count></span><button type="button" data-bio-step="1" aria-label="Next biography page">→</button></div>
      <div class="profile-socials"><% for(const [key,label] of [['github','GitHub'],['linkedin','LinkedIn'],['website','Website']]) { if(member[key]) { %><a href="<%= member[key] %>" target="_blank" rel="noopener noreferrer"><%= label %> ↗</a><% } } %></div>
    </div>
  </div>
  <div class="member-navigation"><button type="button" data-profile-step="-1" aria-label="Previous member">← Previous</button><span role="status" data-profile-count></span><button type="button" data-profile-step="1" aria-label="Next member">Next →</button></div>
</div>
