<div class="team-grid" data-carousel="Leadership" data-carousel-kind="people">
  <% for(const member of team) { %><article class="team-card"><button class="profile-button" type="button" data-member="<%= member.id %>" aria-label="Read about <%= member.name %>"><div class="portrait"><canvas class="member-matrix" aria-hidden="true"></canvas><% if(member.image) { %><img src="<%= member.image %><%= member.image.includes('?')?'&':'?' %>v=matrix-cutout-2" alt="" width="368" height="505" loading="lazy" decoding="async"><% } else { %><span class="initials"><%= member.name.split(' ').map(n=>n[0]).slice(0,2).join('') %></span><% } %><span class="profile-expand" aria-hidden="true">↗</span></div><div class="team-caption"><p class="eyebrow"><%= member.role %></p><h3><%= member.name %></h3><span class="small muted">View profile ↗</span></div></button><template id="member-<%= member.id %>"><%- include('member-profile',{member}) %></template></article><% } %>
</div>
<% if(!team.length) { %><div class="empty-state">The leadership roster will be announced here.</div><% } %>
