<% const feature=events.filter(e=>eventState(e)==='upcoming').sort((a,b)=>a.date.localeCompare(b.date))[0]||events[0];if(feature) { %>
<section class="featured-section wrap" aria-labelledby="featured-heading"><div class="section-heading"><div><p class="eyebrow">THE NEXT CHAPTER STARTS HERE</p><h2 id="featured-heading"><%= eventState(feature)==='upcoming'?'On the horizon.':'Latest from CIPHER.' %></h2></div><a class="text-link" href="/events">All experiences ↗</a></div>
<article class="featured-event"><a href="/events/<%= feature.id %>" class="featured-visual featured-code" aria-label="Explore <%= feature.title %>"><span class="featured-code-word" aria-hidden="true">C/</span><span class="image-label"><%= feature.category %></span><span class="feature-index" aria-hidden="true">01 / SPOTLIGHT</span><span class="featured-code-date"><%= formatDate(feature.date) %></span></a><div class="featured-copy"><span class="status-chip"><%= eventState(feature) %></span><time datetime="<%= feature.date %>"><%= formatDate(feature.date) %><%= feature.time?' · '+feature.time+' IST':'' %></time><h3><%= feature.title %></h3><p><%= feature.summary %></p><p class="feature-venue">↳ <%= feature.location %></p><button type="button" class="button" data-event="<%= feature.id %>" aria-label="View <%= feature.title %> gallery">View Gallery ↗</button></div></article></section><% } %>
