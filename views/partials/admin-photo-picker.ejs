<div class="photo-editor"><p class="eyebrow">THIS EVENT'S PHOTO DECK</p><p class="small muted">Drag selected cards to reorder, or use their arrow buttons. Set any photo as the cover. Changes publish when you save the event.</p><button type="button" class="text-button" data-gallery-library aria-expanded="false">Choose existing photos</button><fieldset class="gallery-choices"><legend>Gallery photos (up to 20)</legend>
<% const selected=(item.gallery||[]).map(path=>assets.find(asset=>asset.path===path)).filter(Boolean),ordered=[...selected,...assets.filter(asset=>!selected.some(photo=>photo.path===asset.path))];for(const asset of ordered) { %>
<div class="photo-option" data-photo-option draggable="true"><label class="checkbox-label"><input type="checkbox" name="gallery" value="<%= asset.path %>" <%= (item.gallery||[]).includes(asset.path)?'checked':'' %>><img src="<%= asset.path %>" width="150" height="100" alt="" loading="lazy"><span><%= asset.label %></span></label><div class="photo-actions"><button type="button" data-photo-move="-1" aria-label="Move photo earlier">←</button><button type="button" data-photo-cover>Set as cover</button><button type="button" data-photo-move="1" aria-label="Move photo later">→</button><button type="button" data-photo-remove aria-label="Remove photo from event">×</button></div></div>
<% } %></fieldset><p class="small muted" data-photo-count role="status"></p></div>
