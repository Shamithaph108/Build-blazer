<section class="section wrap why-join" aria-labelledby="why-heading"><div class="section-heading"><div><p class="eyebrow">WHY JOIN CIPHER</p><h2 id="why-heading">Curiosity belongs here.</h2></div><p>Find your people.<br>Build your next possibility.</p></div><div class="benefit-columns"><% for(const [index,domain] of reference.domains.slice(0,3).entries()) { %><article><span class="benefit-number">0<%= index+1 %></span><h3><%= domain.title %></h3><p><%= domain.description %></p></article><% } %></div><a class="text-link" href="/join">Become part of the community →</a></section>
<section class="section wrap journey-section" aria-labelledby="journey-heading"><div><p class="eyebrow">OUR JOURNEY</p><h2 id="journey-heading">Moments that<br><span class="accent">move us.</span></h2><p>Explore CIPHER through the experiences we have shared and the ideas still taking shape.</p><a class="text-link" href="/events">Explore the archive ↗</a></div><ol class="journey-timeline"><% for(const event of [...events].filter(e=>eventState(e)==='completed').sort((a,b)=>a.date.localeCompare(b.date))) { %><li><time datetime="<%= event.date %>"><%= formatDate(event.date) %></time><span class="journey-dot" aria-hidden="true"></span><div><span class="eyebrow"><%= event.category %></span><h3><a href="/events/<%= event.id %>"><%= event.title %> ↗</a></h3><p><%= event.summary %></p></div></li><% } %><% if(!events.some(e=>eventState(e)==='completed')) { %><li><p>The next CIPHER chapter is taking shape. Published event stories will appear here.</p></li><% } %></ol></section>
<% const memories=events.flatMap(event=>(event.gallery||[]).slice(0,3).map(photo=>({photo,event}))).slice(0,6);if(memories.length) { %><section class="section wrap memories-section" aria-labelledby="memories-heading"><div class="section-heading"><div><p class="eyebrow">BEYOND THE SCREEN</p><h2 id="memories-heading">The people. The moments.</h2></div><a class="text-link" href="/events">Event memories ↗</a></div><div class="memories-grid"><% for(const {photo,event} of memories) { %><a href="/events/<%= event.id %>" class="memory-card"><img src="<%= photo %>" alt="<%= event.title %> — community photograph" width="600" height="450" loading="lazy"><span><%= event.title %> ↗</span></a><% } %></div></section><% } %>
