<div id="<%= purpose==='join'?'inbox':'contact-inbox' %>" data-record-list="<%= purpose %>">
<p class="muted"><%= purpose==='join'?'Accepting an applicant saves a permanent private mailing contact. Only Delete selected member removes that contact.':'Messages sent through Contact appear here. Read, archive or reply without exposing them publicly.' %></p>
<p class="notice"><%= mailConfigured?'SMTP details are present. A reply is marked accepted only after the mail server accepts it.':'Email setup is required. Messages stay safely queued until SMTP is configured.' %></p>
<%- include('admin-filters',{kind:purpose}) %>
<div data-record-items>
<% for(const item of submissions.filter(s=>s.purpose===purpose)) { %>
<article class="inbox-item record-item" data-submission="<%= item.id %>" data-record data-name="<%= item.name %>" data-search="<%= (item.name+' '+item.email+' '+item.message).toLowerCase() %>" data-date="<%= item.created_at %>" data-status="<%= purpose==='join'?item.decision:item.status %>">
<div class="card-top"><span class="badge"><%= purpose==='join'?({pending:'Pending',reviewed:'Reviewed',selected:'Accepted',declined:'Rejected'}[item.decision]||item.decision):({new:'Unread',read:'Read',archived:'Archived'}[item.status]||item.status) %></span><time datetime="<%= item.created_at %>"><%= item.created_at.slice(0,10) %></time></div>
<h3><%= item.name %></h3><a class="text-link" href="mailto:<%= encodeURIComponent(item.email) %>"><%= item.email %></a>
<details class="message-detail"><summary>View complete <%= purpose==='join'?'application':'message' %></summary><p class="preserve-lines"><%= item.message %></p>
<% if(purpose==='join') { %><form class="decision-form" data-id="<%= item.id %>" data-version="<%= item.version %>"><label>Membership decision<select name="decision"><% for(const [value,label] of [['pending','Pending'],['reviewed','Reviewed'],['selected','Accepted'],['declined','Rejected']]) { %><option value="<%= value %>" <%= item.decision===value?'selected':'' %>><%= label %></option><% } %></select></label><label>Private admin notes<textarea name="notes" rows="3" maxlength="2000"><%= item.notes||'' %></textarea></label><% if(item.reviewed_at) { %><p class="small muted">Reviewed by <%= item.reviewed_by %> on <%= item.reviewed_at.slice(0,10) %>.</p><% } %><p class="editor-status" role="status"></p><button type="submit" class="button">Save decision</button></form><% } %></details>
<details class="editor-item"><summary>Write an email to <%= item.name %></summary><form class="reply-form" data-id="<%= item.id %>"><input type="hidden" name="key" value="<%= replyKey() %>"><p>To: <%= item.email %></p><label>Email subject<input name="subject" required maxlength="160" value="Your CIPHER <%= purpose==='join'?'membership application':'enquiry' %>"></label><label>Email message<textarea name="message" required maxlength="8000" rows="5"></textarea></label><p class="editor-status" role="status"></p><button type="submit" class="button"><%= mailConfigured?'Send email':'Queue email' %> →</button></form></details>
<div class="button-row"><button class="button button-outline" data-read-submission="<%= item.id %>" data-status="<%= item.status==='new'?'read':'new' %>" type="button">Mark as <%= item.status==='new'?'read':'unread' %></button><% if(purpose==='contact'&&item.status!=='archived') { %><button type="button" class="text-button" data-read-submission="<%= item.id %>" data-status="archived">Archive message</button><% } %><button class="button button-danger" data-delete-submission="<%= item.id %>" type="button">Delete <%= purpose==='join'?'enquiry':'message' %></button></div><p class="editor-status" role="status"></p>
</article><% } %>
</div><p class="empty-state" data-no-records hidden>No <%= purpose==='join'?'applications':'messages' %> match these filters.</p>
</div>
