<div class="record-filters" role="search" aria-label="Search <%= kind %>"><label>Search <%= kind %><input type="search" data-record-search placeholder="Name, title or details…"></label><label>Status<select data-record-status><option value="">All statuses</option><% const statuses=kind==='join'?[['pending','Pending'],['reviewed','Reviewed'],['selected','Accepted'],['declined','Rejected']]:kind==='contact'?[['new','Unread'],['read','Read'],['archived','Archived']]:[['published','Published'],['draft','Draft']]; for(const [value,label] of statuses) { %><option value="<%= value %>"><%= label %></option><% } %></select></label>
<% if(kind==='events') { %><label>Category<select data-record-category><option value="">All categories</option><% for(const category of ['Competition','Community','Workshop','Talk']) { %><option><%= category %></option><% } %></select></label><label>From date<input type="date" data-record-from></label><label>To date<input type="date" data-record-to></label><% } %>
<label>Sort by<select data-record-sort><option value="default">Default order</option><option value="name">Name / title A–Z</option><% if(kind!=='team') { %><option value="newest">Newest first</option><option value="oldest">Oldest first</option><% } %></select></label><button type="button" class="text-button" data-reset-filters>Reset filters</button><span class="small muted" data-record-count role="status"></span></div>
