<form class="editor-form" data-kind="<%= kind %>" data-id="<%= item.id || '' %>" data-version="<%= item.version || 0 %>">
  <% if(kind==='events') { %>
  <label>Event title<input name="title" required maxlength="120" value="<%= item.title || '' %>"></label><div class="form-row"><label>Date<input name="date" type="date" required value="<%= item.date || '' %>"></label><label>Category<select name="category"><% for(const category of ['Competition','Community','Workshop','Talk']) { %><option <%= item.category===category?'selected':'' %>><%= category %></option><% } %></select></label></div><label>Venue / location<input name="location" required maxlength="160" value="<%= item.location || '' %>"></label><label>Short introduction<textarea name="summary" required maxlength="350" rows="2"><%= item.summary || '' %></textarea></label><label>Full event story<textarea name="description" required maxlength="8000" rows="5"><%= item.description || '' %></textarea></label><label>Information source<input name="source" required maxlength="500" value="<%= item.source || '' %>" placeholder="Approved report, organiser, or source document"></label>
  <div class="form-row"><label>Start time (IST, optional)<input name="time" type="time" value="<%= item.time||'' %>"></label><label>Event status<select name="eventStatus"><% for(const [value,label] of [['auto','Automatic from date'],['upcoming','Upcoming'],['completed','Completed'],['postponed','Postponed'],['cancelled','Cancelled']]) { %><option value="<%= value %>" <%= (item.eventStatus||'auto')===value?'selected':'' %>><%= label %></option><% } %></select></label></div>
  <% } else if(kind==='activities') { %>
  <label>Activity title<input name="title" required maxlength="120" value="<%= item.title || '' %>"></label><label>Activity information<textarea name="description" maxlength="8000" rows="5"><%= item.description || '' %></textarea></label><p class="muted">Add verified details. An empty description shows an information-pending message.</p><label>Display order<input name="order" type="number" min="0" max="999" required value="<%= item.order ?? 1 %>"></label>
  <% } else if(kind==='domains') { %>
  <label>Domain title<input name="title" required maxlength="120" value="<%= item.title || '' %>"></label><label>Domain description<textarea name="description" required maxlength="1000" rows="3"><%= item.description || '' %></textarea></label><div class="form-row"><label>Icon<select name="icon"><% for(const icon of ['code','crown','people','rocket','email','github','linkedin','instagram']) { %><option value="<%= icon %>" <%= (item.icon||'code')===icon?'selected':'' %>><%= icon %></option><% } %></select></label><label>Display order<input name="order" type="number" min="0" max="999" required value="<%= item.order ?? 0 %>"></label></div>
  <% } else { %>
  <label>Full name<input name="name" required maxlength="100" value="<%= item.name || '' %>"></label><label>Role<input name="role" required maxlength="100" value="<%= item.role || '' %>"></label><label>Introduction<textarea name="bio" required maxlength="1500" rows="3"><%= item.bio || '' %></textarea></label><label>Display order<input name="order" type="number" min="0" max="999" required value="<%= item.order ?? 1 %>"></label>
  <% } %>
  <% if(kind==='team') { %><label>Department<input name="department" maxlength="160" value="<%= item.department||'' %>"></label><div class="form-row"><% for(const key of ['github','linkedin','website']) { %><label><%= key %> URL<input name="<%= key %>" type="url" maxlength="300" placeholder="https://" value="<%= item[key]||'' %>"></label><% } %></div><% } %>
  <% if(kind!=='domains') { %>
  <label><%= kind==='team'?'Portrait':'Cover image' %><select name="image"><option value="">No image</option><% for(const asset of assets) { %><option value="<%= asset.path %>" <%= item.image===asset.path?'selected':'' %>><%= asset.label %></option><% } %></select></label>
  <div class="inline-image-editor">
    <img data-image-preview src="<%= item.image || '' %>" alt="Selected photograph" width="240" height="180" <%= item.image?'':'hidden' %>>
    <label><%= kind==='team'?'Add a portrait photo':'Upload a cover image' %><input type="file" name="imageUpload" accept="image/jpeg,image/png,image/webp" data-image-file></label>
    <div class="button-row"><button type="button" class="button button-outline" data-upload-image>Upload and use photo</button><button type="button" class="text-button" data-remove-image>Remove image</button></div>
    <p class="small muted">Choose directly from your computer or phone. JPG, PNG or WebP, up to 3 MB. Your chosen file also uploads automatically when you save. Publish to show it on the website.</p>
  </div>
  <% } %>
  <% if(kind==='events') { %><label>Upload gallery photos<input type="file" name="galleryUpload" accept="image/jpeg,image/png,image/webp" multiple data-gallery-files></label><button type="button" class="button button-outline" data-upload-gallery>Add photos to gallery</button><p class="small muted">Choose multiple photos directly from your device, up to 20 gallery photos in total. Uncheck a photo below to remove it from this event.</p><% } %>
  <% if(kind==='events') { %><%- include('admin-photo-picker',{item,assets}) %><% } %>
  <label class="checkbox-label"><input name="published" type="checkbox" <%= item.published?'checked':'' %>><span>Published — visible on the website</span></label>
  <p class="editor-status" role="status" aria-live="polite"></p><div class="button-row"><button type="submit" class="button"><%= item.id?'Save changes':'Create '+({events:'event',activities:'activity',team:'member',domains:'domain'}[kind] || 'item') %> ↗</button><% if(item.id) { %><button type="button" class="button button-danger" data-delete-content><%= kind==='team'?'Delete member':'Delete' %></button><% } %></div>
</form>
