<div class="settings-grid"><form class="settings-form overview-module" data-settings-version="<%= siteSettings.version %>"><h3>Public website details</h3><label>Homepage tagline<textarea name="tagline" required maxlength="350" rows="3"><%= siteSettings.tagline %></textarea></label><label>Contact email<input name="contactEmail" type="email" maxlength="254" value="<%= siteSettings.contactEmail %>"></label><label>Postal address<textarea name="address" maxlength="500" rows="3"><%= siteSettings.address %></textarea></label><% for(const key of ['github','linkedin','instagram']) { %><label><%= key %> URL<input name="<%= key %>" type="url" maxlength="300" placeholder="https://" value="<%= siteSettings[key] %>"></label><% } %><label>Verified participants reached<input name="participants" type="number" min="0" max="10000000" value="<%= siteSettings.participants??'' %>"></label><label>Participant count source<input name="participantsSource" maxlength="350" value="<%= siteSettings.participantsSource %>" placeholder="Approved report or attendance record"></label><p class="small muted">Leave the count blank until confirmed. Other counters use published events, leaders and activities.</p><p class="editor-status" role="status"></p><button type="submit" class="button">Save settings ↗</button></form>
<form class="password-form overview-module"><p class="eyebrow">ADMIN PROFILE</p><h3><%= username %></h3><p class="muted">Use at least 8 characters. Changing your password signs out all existing sessions.</p><label>Current password<input name="currentPassword" type="password" required autocomplete="current-password" maxlength="256"></label><label>New password<input name="newPassword" type="password" required autocomplete="new-password" minlength="8" maxlength="256"></label><label>Confirm new password<input name="confirmPassword" type="password" required autocomplete="new-password" minlength="8" maxlength="256"></label><p class="editor-status" role="status"></p><button class="button button-outline" type="submit">Change password</button></form></div>
