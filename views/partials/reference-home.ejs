<canvas id="contour-field" aria-hidden="true"></canvas>
<section class="reference-hero" id="home" aria-labelledby="hero-title">
  <%- include('signal-field') %>
  <div class="hero-meta-line"><span class="status-dot"></span><span>CSE ASSOCIATION / SJEC</span><span class="hero-location">MANGALURU, INDIA</span></div>
  <div class="hero-art"><canvas id="matrix-wordmark" aria-hidden="true"></canvas><h1 id="hero-title" class="hero-wordmark">CIPHER</h1></div>
  <div class="reference-hero-copy"><div><p class="eyebrow hero-decrypt" data-type-line>CREATE. CONNECT. COLLABORATE.</p><h2>Student Association of Computer Science &<br class="reference-break"> Engineering</h2></div><div><p class="hero-tagline"><%= siteSettings.tagline %></p><div class="button-row"><a class="button" href="#events">Explore Events ↗</a><a class="button button-outline" href="#join-contact">Join / Contact →</a></div></div></div><a class="hero-scroll" href="#about"><span aria-hidden="true">↓</span> SCROLL TO EXPLORE</a>
</section>
<section class="reference-section reference-about" id="about">
  <div><p class="eyebrow">// ABOUT</p><h2 data-decode>Who we are</h2><p class="reference-about-copy"><strong>CIPHER</strong><%= reference.about.slice(6) %></p></div>
  <div class="reference-collage" data-carousel="CIPHER moments" data-carousel-kind="photos">
    <figure class="moment-card"><img src="/images/promptops-09.webp" alt="Students at PROMPT OPS" width="420" height="300" loading="lazy"><figcaption><span>PROMPT OPS</span><strong>Ideas taking shape</strong></figcaption></figure>
    <figure class="moment-card"><img src="/images/lumiere.webp" alt="Lumière — The Gala" width="426" height="325" loading="lazy"><figcaption><span>LUMIÈRE</span><strong>Where the community meets</strong></figcaption></figure>
    <figure class="moment-card"><img src="/images/lumiere-gallery-02.webp" alt="Lumière activities" width="426" height="292" loading="lazy"><figcaption><span>CIPHER MOMENTS</span><strong>Built together</strong></figcaption></figure>
    <figure class="moment-card"><img src="/images/lumiere-gallery-03.webp" alt="CIPHER branch-entry celebration" width="426" height="360" loading="lazy"><figcaption><span>THE GALA</span><strong>A shared celebration</strong></figcaption></figure>
  </div>
</section>
<section class="reference-section" id="domains">
  <p class="eyebrow">// WHAT WE DO</p>
  <h2 data-decode>Our Domains</h2>
  <div class="reference-domains" data-carousel="Domains" data-carousel-kind="cards">
    <% for(const domain of reference.domains) { %>
      <article class="reference-domain slide-on-scroll" tabindex="0" role="button" data-domain-card data-title="<%= domain.title %>" data-description="<%= domain.description %>" data-icon="<%= domain.icon %>">
        <span class="reference-domain-icon"><%- include('icon',{name:domain.icon}) %></span>
        <span class="domain-status">↗ EXPLORE</span>
        <h3><%= domain.title %></h3>
        <p><%= domain.description %></p>
      </article>
    <% } %>
  </div>
</section>
<section class="reference-section reference-leadership" id="leadership"><p class="eyebrow">// GOVERNANCE</p><h2 data-decode>Leadership Structure</h2>
  <div class="team-controls" aria-label="Leadership carousel controls"><button type="button" data-team-step="-1" aria-label="Previous leaders">←</button><button type="button" data-team-step="1" aria-label="Next leaders">→</button></div>
  <div class="reference-team-window" role="region" aria-label="Leadership"><div class="reference-team-track">
    <% const displayTeam=[...team].sort((a,b)=>{const order=['nazmin-ziya','jeslin-ninora','elston-pereira','raynell-lewis'];return (order.includes(a.id)?order.indexOf(a.id):10+a.order)-(order.includes(b.id)?order.indexOf(b.id):10+b.order);}); %>
    <% for(const member of displayTeam) { %><article class="reference-person"><button type="button" class="profile-button" data-member="<%= member.id %>" aria-label="Read about <%= member.name %>"><div class="portrait"><canvas class="member-matrix" aria-hidden="true"></canvas><% if(member.image) { %><img src="<%= member.image %><%= member.image.includes('?')?'&':'?' %>v=matrix-cutout-2" alt="" width="368" height="505" loading="lazy"><% } else { %><span class="initials"><%= member.name.split(' ').map(n=>n[0]).slice(0,2).join('') %></span><% } %></div><div class="reference-person-caption"><p class="eyebrow"><%= member.role %></p><h3><%= member.name %></h3></div></button><div class="reference-socials"><% for(const key of ['github','linkedin']) { if(member[key]) { %><a href="<%= member[key] %>" aria-label="<%= member.name %> on <%= key %>" target="_blank" rel="noopener noreferrer"><%- include('icon',{name:key}) %></a><% } } %></div><template id="member-<%= member.id %>"><%- include('member-profile',{member}) %></template></article><% } %>
  </div></div>
</section>
<section class="reference-section" id="events"><p class="eyebrow">// ACTIVITIES</p><h2 data-decode>Events & Workshops</h2><div class="reference-events" data-carousel="Events and workshops" data-carousel-kind="events">
  <% for(const event of [...events].sort((a,b)=>a.date.localeCompare(b.date))) { %><article class="reference-event"><div class="event-code-mark" aria-hidden="true"><span>CIPHER</span><span><%= event.category.toUpperCase() %></span></div><div class="reference-event-meta"><span>▣ <%= event.category==='Community'?'BRANCH GALA':event.category.toUpperCase() %></span><time datetime="<%= event.date %>"><%= formatDate(event.date) %></time></div><h3><button type="button" data-event="<%= event.id %>"><%= event.title %></button></h3><p><%= event.summary %></p><div class="reference-event-location"><%= event.location %> · <span class="status-chip"><%= eventState(event) %></span></div><button type="button" class="text-button" data-event="<%= event.id %>" aria-label="View <%= event.title %> gallery">VIEW GALLERY ↗</button><template id="event-<%= event.id %>"><div class="dialog-grid"><div><p class="eyebrow">CIPHER // ACTIVITIES</p><h2 id="dialog-title"><%= event.title %></h2><p class="reference-event-date"><%= formatDate(event.date) %> · <%= event.location %></p><div class="prose"><% for(const paragraph of event.description.split('\n\n')) { %><p><%= paragraph %></p><% } %></div></div><%- include('gallery',{event}) %></div></template></article><% } %>
  <% if(!events.length) { %><p>Event announcements will appear here.</p><% } %>
</div></section>
<section class="reference-section reference-archive" id="activities"><p class="eyebrow">// ARCHIVE</p><h2 data-decode>Activities</h2><p>Hands-on workshops, industrial visits, and technical sessions run by the Cipher Association — spanning AI, blockchain, research tooling, and career prep.</p><div class="reference-activity-grid"><% for(const [i,activity] of activities.entries()) { %><button type="button" class="reference-activity" data-activity="<%= activity.id %>"><span><%= String(i+1).padStart(2,'0') %></span><span><%= activity.title %></span><span aria-hidden="true">↗</span></button><template id="activity-<%= activity.id %>"><h2 id="dialog-title"><%= activity.title %></h2><% if(activity.image) { %><img class="activity-image" src="<%= activity.image %>" alt="<%= activity.title %>" width="600" height="400" loading="lazy"><% } %><p class="preserve-lines"><%= activity.description || 'Detailed information for this activity is awaiting confirmation. Contact the association for more information.' %></p></template><% } %></div><% if(!activities.length) { %><p>Activities will be announced here.</p><% } %></section>
<section class="reference-join" id="join-contact"><span id="join" aria-hidden="true"></span><p class="eyebrow">// JOIN / CONTACT</p><h2 data-decode>Start a conversation</h2><p>Join the CIPHER community, ask a question, or propose a collaboration. Both paths reach the team’s private admin inbox.</p><div class="button-row"><a href="/join" class="button" data-join-modal>Join CIPHER →</a><a href="/contact" class="button button-outline">Contact the team ↗</a></div></section>
<template id="join-form-template"><div class="reference-join-modal"><p class="eyebrow">// ACCESS REQUEST</p><h2 id="dialog-title">Join CIPHER</h2><p>Send us a message and we’ll get back to you.</p><form action="/join" method="post" data-modal-form><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="purpose" value="join"><input type="hidden" name="consent" value="yes"><div class="honeypot" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div><label for="modal-name">Name<input id="modal-name" name="name" autocomplete="name" required minlength="2" maxlength="100" placeholder="Enter your name"></label><label for="modal-email">Email<input id="modal-email" name="email" type="email" autocomplete="email" required maxlength="254" placeholder="Enter your email"></label><label for="modal-message">Message<textarea id="modal-message" name="message" rows="4" required minlength="10" maxlength="3000" placeholder="Tell us why you’d like to join…"></textarea></label><p class="reference-form-privacy">By sending, you agree that authorised editors may store and review your enquiry.</p><p class="reference-form-status" role="status" aria-live="polite"></p><button type="submit" class="button full-width">Send →</button></form></div></template>
<dialog id="intro" class="reference-intro" aria-label="CIPHER opening sequence" hidden><canvas id="intro-rain" aria-hidden="true"></canvas><div class="reference-scanlines" aria-hidden="true"></div><div class="reference-boot-text" aria-hidden="true"><div>&gt; establishing connection...</div><div>&gt; authenticating access...</div><div>&gt; decrypting CIPHER_v1.0...</div><div>&gt; loading modules... [==========] 100%</div><div>&gt; access granted.</div></div><div class="reference-intro-word" aria-hidden="true"></div><button type="button" id="skip-intro">[ SKIP &gt; ]</button></dialog>
<div id="reference-cursor" aria-hidden="true"><span></span></div>
