</main>
<% if(currentPath.startsWith('/admin')) { %><footer class="admin-footer"><span>CIPHER / PRIVATE WORKSPACE</span><span>© <%= year %> CIPHER · SJEC</span></footer><% } else { %>
<footer class="site-footer premium-footer wrap"><div class="footer-grid"><div><a class="footer-wordmark" href="/">CIPHER<span aria-hidden="true">_</span></a><p>Student Association · Computer Science & Engineering<br>St. Joseph Engineering College, Mangaluru</p><p class="footer-motto">Create. Connect. Collaborate.</p></div><div><p class="eyebrow">EXPLORE</p><nav aria-label="Footer navigation"><a href="/about">About</a><a href="/events">Events & Workshops</a><a href="/team">Leadership</a><a href="/join">Join / Contact</a></nav></div><div><p class="eyebrow">FIND YOUR PEOPLE</p><p class="preserve-lines"><%= siteSettings.address %></p><% if(siteSettings.contactEmail) { %><a class="text-link" href="mailto:<%= siteSettings.contactEmail %>"><%= siteSettings.contactEmail %></a><% } %><div class="footer-socials"><% for(const key of ['github','linkedin','instagram']) { if(siteSettings[key]) { %><a href="<%= siteSettings[key] %>" target="_blank" rel="noopener noreferrer" aria-label="CIPHER on <%= key %>"><%- include('icon',{name:key}) %></a><% } } %></div></div></div><div class="footer-bottom"><span>© <%= year %> CIPHER · SJEC</span><span>Built with curiosity. Connected by code.</span><a href="#top">Back to top ↑</a></div></footer><% } %>
<dialog id="detail-dialog" aria-labelledby="dialog-title"><div class="dialog-chrome" aria-hidden="true"><span class="dialog-signal"></span><span data-dialog-label>CIPHER / EXPLORE</span><span class="dialog-chrome-line"></span></div><button type="button" class="dialog-close" aria-label="Close dialog">×</button><div id="dialog-content"></div></dialog>
<dialog id="confirm-dialog" aria-labelledby="confirm-title"><p class="eyebrow">CIPHER / CONFIRM ACTION</p><h2 id="confirm-title">Confirm this change</h2><p data-confirm-message></p><form method="dialog" class="button-row"><button value="cancel" class="button button-outline">Cancel</button><button value="confirm" class="button" data-confirm-accept>Confirm</button></form></dialog>
<div id="toast-region" role="status" aria-live="polite"></div>
<% if(!currentPath.startsWith('/admin')) { %><button class="cipher-chat-launch" type="button" aria-haspopup="dialog" aria-controls="cipher-chat">Ask CIPHER &nearr;</button><dialog id="cipher-chat" aria-labelledby="cipher-chat-title"><div class="chat-heading"><h2 id="cipher-chat-title">Ask CIPHER</h2><button type="button" data-chat-close aria-label="Close chat">&times;</button></div><p class="small muted">Website guide - Answers from published content. Please don't share personal information.</p><div class="chat-messages" role="log" aria-live="polite" aria-relevant="additions"><p class="chat-answer">Hello! Ask about events, leadership, joining or announcements.</p></div><form id="cipher-chat-form"><label for="chat-question">Your question</label><div class="chat-compose"><input id="chat-question" name="question" required maxlength="500" autocomplete="off" placeholder="How can I join CIPHER?"><button class="button" type="submit">Ask</button></div><p data-chat-status role="status"></p></form></dialog><% } %>
</body>
</html>
