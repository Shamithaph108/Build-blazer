<%- include('partials/head') %>
<section class="page-heading wrap"><p class="eyebrow">// YOUR NEXT CONNECTION</p><h1>Let’s build<br><span class="accent">what comes next.</span></h1><p class="lead">Bring your curiosity. Find your community.</p></section>
<section class="section wrap contact-grid"><div><p class="eyebrow"><%= currentPath==='/contact'?'// CONTACT CIPHER':'// JOIN CIPHER' %></p><h2>You belong in<br>the conversation.</h2><p>Interested in joining, collaborating, or learning more? Send the team a message.</p><div class="contact-detail"><span class="mono accent">01 / FIND US</span><p class="preserve-lines"><%= siteSettings.address %></p></div><div class="contact-detail"><span class="mono accent">02 / STAY CONNECTED</span><% if(siteSettings.contactEmail) { %><a class="text-link" href="mailto:<%= siteSettings.contactEmail %>"><%= siteSettings.contactEmail %></a><% } else { %><p>Leave a message using the form. The CIPHER team will review it privately.</p><% } %></div><p class="small muted">Your name, email, and message are saved privately for the site’s authorised editors. Please don’t include passwords or sensitive personal information.</p></div>
<div class="form-panel"><p class="eyebrow">// OPEN A CONNECTION</p><h2>Send a message.</h2>
<% if(success) { %><div class="notice success" id="form-status" role="status" tabindex="-1"><strong>Message saved successfully.</strong><p>Your enquiry is in the team’s private inbox for review. The team can reply to the email address you provided.</p></div><% } %>
<% if(Object.keys(errors).length) { %><div class="notice error" id="form-status" role="alert" tabindex="-1"><strong>Please check the highlighted fields.</strong><ul><% for(const [key,error] of Object.entries(errors)) { %><li><a href="#<%= key %>"><%= key %>: <%= error %></a></li><% } %></ul></div><% } %>
<form action="/join" method="post" id="contact-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="honeypot" aria-hidden="true"><label>Website<input name="website" id="website" tabindex="-1" autocomplete="off"></label></div><div class="form-row"><label for="name">Your name <span class="accent">*</span><input id="name" name="name" autocomplete="name" required minlength="2" maxlength="100" value="<%= values.name || '' %>" <%- errors.name?'aria-invalid="true" aria-describedby="name-error"':'' %>><% if(errors.name) { %><span class="field-error" id="name-error"><%= errors.name %></span><% } %></label><label for="email">Email address <span class="accent">*</span><input id="email" name="email" type="email" autocomplete="email" required maxlength="254" value="<%= values.email || '' %>" <%- errors.email?'aria-invalid="true" aria-describedby="email-error"':'' %>><% if(errors.email) { %><span class="field-error" id="email-error"><%= errors.email %></span><% } %></label></div><label for="purpose">I’m here to <span class="accent">*</span><select id="purpose" name="purpose" required><option value="join" <%= values.purpose==='join'?'selected':'' %>>Express interest in joining</option><option value="contact" <%= values.purpose==='contact'?'selected':'' %>>Ask a question / collaborate</option></select></label><label for="message">Your message <span class="accent">*</span><textarea id="message" name="message" rows="5" required minlength="10" maxlength="3000" placeholder="Tell us a little about yourself and what brings you here…" <%- errors.message?'aria-invalid="true" aria-describedby="message-error"':'' %>><%= values.message || '' %></textarea><% if(errors.message) { %><span class="field-error" id="message-error"><%= errors.message %></span><% } %></label><label class="checkbox-label" for="consent"><input type="checkbox" name="consent" id="consent" value="yes" required <%= values.consent==='yes'?'checked':'' %>><span>I agree to my enquiry being stored and reviewed by authorised CIPHER website editors. <span class="accent">*</span></span></label><button type="submit" class="button full-width">Send message <span aria-hidden="true">↗</span></button><p class="small muted">* Required fields. Membership is subject to confirmation by the association.</p></form></div></section>
<%- include('partials/footer') %>
