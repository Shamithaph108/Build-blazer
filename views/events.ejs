<%- include('partials/head') %>
<section class="page-heading wrap"><p class="eyebrow">// IDEAS. PEOPLE. POSSIBILITIES.</p><h1>Events &<br><span class="accent">experiences.</span></h1><p class="lead">Where learning becomes something you can be part of.</p></section>
<%- include('partials/featured-event') %><section class="section wrap upcoming-events" aria-labelledby="upcoming-title"><div class="section-heading"><div><p class="eyebrow">COMING NEXT</p><h2 id="upcoming-title">On the calendar.</h2></div></div><% const upcoming=events.filter(event=>eventState(event)==='upcoming').sort((a,b)=>a.date.localeCompare(b.date));if(upcoming.length) { %><div class="public-upcoming"><% for(const event of upcoming) { %><a class="upcoming-row" href="/events/<%= event.id %>"><time datetime="<%= event.date %>"><%= formatDate(event.date) %></time><strong><%= event.title %></strong><span class="small"><%= event.location %> ↗</span></a><% } %></div><% } else { %><p class="empty-state">The next CIPHER experience is taking shape. Follow the event announcements here or <a class="text-link" href="/join">join the community</a>.</p><% } %></section><section class="section wrap events-section" aria-label="Event archive"><div class="filter-bar"><div class="filter-buttons" role="group" aria-label="Filter by category"><% for(const category of ['All','Competition','Community','Workshop','Talk']) { %><button type="button" class="filter-button" data-filter="<%= category %>" aria-pressed="<%= category==='All' %>"><%= category %></button><% } %></div><label class="search-label"><span class="sr-only">Search events</span><input type="search" id="event-search" placeholder="Search events…" maxlength="100"></label></div><p class="small muted" id="event-count" aria-live="polite"><%= events.length %> events in the archive</p><%- include('partials/events') %><p id="no-events" class="empty-state" hidden>No matching events. Try another search or category.</p><div class="archive-note"><span class="status-dot"></span><p>Upcoming events will appear here when announced. Browse the archive to see what we’ve been building together.</p></div></section>
<%- include('partials/cta') %><%- include('partials/footer') %>
