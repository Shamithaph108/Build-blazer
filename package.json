{
  "name": "cipher-buildblazer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "build": "node scripts/build.js",
    "start": "node --env-file-if-exists=.env server/index.js --production",
    "admin:setup": "node --env-file-if-exists=.env scripts/setup-admin.js",
    "test": "node --test --test-concurrency=1 tests/server.test.js",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@vercel/functions": "^3.9.9",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "mongodb": "^7.6.0",
    "nodemailer": "^10.0.10",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2"
  }
}
