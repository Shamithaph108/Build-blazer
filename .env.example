PORT=3000
HOST=127.0.0.1
BASE_URL=http://localhost:3000
DATA_DIR=./data
# Vercel's MongoDB Atlas integration supplies MONGODB_URI automatically.
MONGODB_URI=
# Local fallback when MONGODB_URI is empty:
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=cipher
# Production: set BASE_URL to your HTTPS domain and HOST=0.0.0.0.
# Vercel automatically trusts its single proxy hop; no TRUST_PROXY variable needed.
# On other hosts, set TRUST_PROXY=1 only behind exactly one trusted reverse proxy.
# ADMIN_USERNAME and ADMIN_PASSWORD are only used by npm run admin:setup.
# Never commit a real password or your .env file.

# Email: use the SMTP details issued by your mail provider.
# Local: set these in the private .env, then restart npm run dev.
# Vercel: set them in Project Settings > Environment Variables > Production, then redeploy.
# Gmail SMTP_PASS must be a Google App Password, NEVER a normal Google password.
# 587 uses STARTTLS; 465 uses TLS from connection start.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
ADMIN_NOTIFY_EMAIL=
# MAIL_FROM and ADMIN_NOTIFY_EMAIL must each be one email address.
# Existing queued messages send after configuration; review the outbox first.
